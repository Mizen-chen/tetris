<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="@color/morandi_bg"
                                                   android:padding="16dp">

    <!-- 顶部状态栏卡片 -->
    <androidx.cardview.widget.CardView
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

            <!-- 分数、消行、等级 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <TextView
                        android:id="@+id/tv_score"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="分数：0"
                        android:textColor="@color/morandi_text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/tv_lines"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="消行：0"
                        android:textColor="@color/morandi_text_medium"
                        android:textSize="16sp"
                        android:gravity="center" />

                <TextView
                        android:id="@+id/tv_level"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="等级：1"
                        android:textColor="@color/morandi_text_medium"
                        android:textSize="16sp"
                        android:gravity="end" />
            </LinearLayout>

            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/morandi_neutral_light" />

            <!-- 辅助功能区 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_game_rank"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="查看排行榜"
                        android:textColor="@color/morandi_secondary"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/morandi_secondary_light"
                        app:cornerRadius="20dp" />

                <!-- 重新开始按钮：莫兰迪灰蓝 -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_restart_game"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="重开"
                        android:textColor="@color/morandi_secondary"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/morandi_secondary"
                        app:iconSize="16dp"
                        app:iconPadding="4dp"
                        app:backgroundTint="@color/morandi_secondary_light"
                        app:cornerRadius="20dp" />

                <!-- 退出按钮：莫兰迪灰玫红 -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_exit_game"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="退出"
                        android:textColor="@color/morandi_warning"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_close"
                        app:iconTint="@color/morandi_warning"
                        app:iconSize="16dp"
                        app:iconPadding="4dp"
                        app:backgroundTint="@color/morandi_warning_light"
                        app:cornerRadius="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 游戏主画布，使用卡片包裹产生高级感 -->
    <androidx.cardview.widget.CardView
            android:id="@+id/card_game"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_controls"
            app:layout_constraintTop_toBottomOf="@+id/card_header">

        <com.example.tetris.ui.GameView
                android:id="@+id/game_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp" />
    </androidx.cardview.widget.CardView>

    <!-- 底部控制区 -->
    <LinearLayout
            android:id="@+id/layout_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

        <!-- 方向与旋转 (主操作) -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_left"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="向左"
                    android:textSize="16sp"
                    app:backgroundTint="@color/morandi_neutral_light"
                    android:textColor="@color/morandi_text_dark"
                    app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rotate"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.5"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="旋 转"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/morandi_primary"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_right"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="向右"
                    android:textSize="16sp"
                    app:backgroundTint="@color/morandi_neutral_light"
                    android:textColor="@color/morandi_text_dark"
                    app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- 速降与暂停 (辅操作) -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_drop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="速 降"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/morandi_amber"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pause"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="暂 停"
                    android:textSize="16sp"
                    app:backgroundTint="@color/morandi_neutral_light"
                    android:textColor="@color/morandi_text_dark"
                    app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>